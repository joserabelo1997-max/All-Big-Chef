# Copie para `.env` e preencha. Veja docs/SETUP_SUPABASE.md para obter cada valor.
#
# Nada aqui é segredo: tudo que começa com VITE_ vai para dentro do bundle
# JavaScript e fica visível para qualquer pessoa que abrir o app. A anon key do
# Supabase foi desenhada assim — quem protege os dados são as políticas de RLS
# no banco, não o sigilo da chave. Segredos de verdade (service_role, chave
# privada VAPID) ficam apenas nos secrets da Edge Function, nunca aqui.

# Painel do Supabase → Project Settings → Data API
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=

# Chave PÚBLICA do par VAPID, usada para assinar o Web Push das validades.
# A chave privada correspondente vai nos secrets da Edge Function.
VITE_VAPID_PUBLIC_KEY=
